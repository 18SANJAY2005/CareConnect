# CareConnect Backend Environment Configuration

# Database Connection (PostgreSQL with psycopg driver)
# Example: postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/careconnect
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/careconnect

# Application Environment
ENVIRONMENT=development
SECRET_KEY=careconnect-super-secret-jwt-key-chennai-2026

# Third-Party Integrations (Optional for local development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
