# CareConnect Backend Environment Configuration (.env.example)
# IMPORTANT: Use placeholder values only. Never store real credentials or secrets in this template.

# ----------------------------------------------------------------------------
# Application Environment
# ----------------------------------------------------------------------------
# Options: development, staging, production, test
ENVIRONMENT=production
PROJECT_NAME="CareConnect Elder Care Platform"
VERSION=1.0.0
API_V1_STR=/api

# ----------------------------------------------------------------------------
# Security & JWT Authentication
# ----------------------------------------------------------------------------
# Replace with a cryptographically secure random 256-bit string in production
SECRET_KEY=replace_with_secure_production_jwt_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------------------------------
# Database Connection (Authoritative Production: PostgreSQL 18 with psycopg)
# Format: postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://careconnect_user:replace_with_production_db_password@localhost:5432/careconnect_prod

# ----------------------------------------------------------------------------
# CORS Configuration
# Comma-separated list of allowed origins or JSON array format
# ----------------------------------------------------------------------------
# Example for production: https://family.careconnect.in,https://caregiver.careconnect.in
CORS_ORIGINS=["https://family.careconnect.in","https://caregiver.careconnect.in","http://localhost:5173","http://localhost:5174"]

# ----------------------------------------------------------------------------
# Third-Party Integrations (Optional)
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
JITSI_DOMAIN=meet.jit.si
